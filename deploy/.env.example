# Production environment for Project-X
# Copy this file: cp deploy/.env.example deploy/.env
# Fill in real values — do NOT commit deploy/.env to git.
#
# After editing, run:  bash deploy/setup.sh   (or deploy/deploy.sh on an existing box)

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=projectx
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=projectx
POSTGRES_SSLMODE=disable

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ---- Token encryption ----
# 32-byte AES-256 key, base64-encoded. REQUIRED.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# ---- Internal service-to-service auth ----
# Used by wa-web → api. REQUIRED — stack refuses to start without it.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ---- Super Admin (first login) ----
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---- Domain & URLs ----
PUBLIC_FORM_BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ---- Cookies (HTTPS) ----
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true

# ---- Meta / WhatsApp ----
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_random_token
META_GRAPH_API_VERSION=v21.0

# ---- Stripe ----
# Get from: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ---- Google Sheets (optional) ----
# Place service-account JSON at deploy/secrets/google-credentials.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads

# ---- AI providers (optional — leave blank to disable AI features) ----
CLAUDE_API_KEY=
GROQ_API_KEY=

# ---- AWS / S3 (optional — file uploads / storage) ----
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# ---- Glofox (optional — studio management integration) ----
# All three required together to enable Glofox; leave all blank to disable.
GLOFOX_API_KEY=
GLOFOX_API_TOKEN=
GLOFOX_BRANCH_ID=
