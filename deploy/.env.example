# Production environment for Project-X
# Copy this file: cp deploy/.env.example deploy/.env
# Fill in real values — do NOT commit deploy/.env to git.
#
# After editing, run:  bash deploy/setup.sh   (or deploy/deploy.sh on an existing box)

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=projectx
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=projectx
POSTGRES_SSLMODE=disable

# ---- Postgres read replica (streaming replication, optional) ----
# Password for the `replicator` role that postgres_replica uses to
# pg_basebackup/stream from the primary (see deploy/postgres/). REQUIRED —
# both the postgres and postgres_replica services fail fast without it.
# Generate with: openssl rand -hex 32
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_run_openssl_rand_hex_32
# Host the API can optionally point read-only queries at once the Go side
# supports it (a separate, in-progress change) — same user/password/db/port
# as POSTGRES_HOST above, just a different host. Leave as-is; only change
# this if you rename the postgres_replica service in docker-compose.yml.
POSTGRES_READ_HOST=postgres_replica

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ---- Token encryption ----
# 32-byte AES-256 key, base64-encoded. REQUIRED.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# ---- Redis (AI answer cache) ----
# Runs as its own container (`redis`), backend-network-only, never exposed on
# a host port. REQUIRED — the stack refuses to start without it (same
# fail-fast pattern as JWT_SECRET/TOKEN_ENCRYPTION_KEY above).
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_run_openssl_rand_base64_24
# Optional: override the AI-answer cache TTL (Go duration syntax, default 30m).
AI_ANSWER_CACHE_TTL=30m
# Optional: override the session idle timeout (Go duration syntax, default
# 30m) — a session with no authenticated requests at all for this long is
# force-expired. As long as requests keep coming within this window, both
# this deadline and JWT_TTL slide forward on every request. Unlike the AI
# cache, Redis being unreachable here fails auth closed rather than
# degrading.
SESSION_IDLE_TIMEOUT=30m
# Optional: hard backstop (Go duration syntax, default 168h / 7 days) — set
# once at login and never extended by activity, unlike SESSION_IDLE_TIMEOUT
# above. Even a continuously-active session is force-logged-out once this
# elapses.
# SESSION_MAX_AGE=168h

# ---- Internal service-to-service auth ----
# Used by wa-web/tg-web → api. REQUIRED — stack refuses to start without it.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ---- Super Admin (first login) ----
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---- Domain & URLs ----
PUBLIC_FORM_BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
# Domain root, no /api suffix — used to register the Telegram bot webhook
# (see docs/SETUP_TELEGRAM.md). Defaults to PUBLIC_FORM_BASE_URL if unset,
# which is correct for this same-origin nginx setup.
PUBLIC_API_BASE_URL=https://yourdomain.com

# ---- Cookies (HTTPS) ----
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true

# ---- Meta / WhatsApp ----
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_random_token
META_GRAPH_API_VERSION=v21.0

# ---- Telegram QR-login (tg-web) ----
# Platform-wide app credentials, one-time, from https://my.telegram.org
# (log in with any phone number → API development tools → create an app).
# Only needed if you plan to offer the QR-linked "Telegram (personal
# account)" channel — the bot-token Telegram channel doesn't need these.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Stripe ----
# Get from: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ---- Google Sheets (optional) ----
# Place service-account JSON at deploy/secrets/google-credentials.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads

# ---- AI providers (optional — leave blank to disable AI features) ----
CLAUDE_API_KEY=
GROQ_API_KEY=

# ---- Local embeddings service (apps/embeddings) ----
# Runs as its own container (`embeddings`) reachable internally at
# http://embeddings:8001 — no API key needed. Only set this if you want a
# different sentence-transformers model; it must still output 768-dim
# vectors (see apps/embeddings/README.md) or writes will fail at the
# pgvector cast.
EMBEDDINGS_MODEL_NAME=intfloat/multilingual-e5-base

# ---- AWS / S3 (optional — file uploads / storage) ----
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# ---- Glofox (optional — studio management integration) ----
# All three required together to enable Glofox; leave all blank to disable.
GLOFOX_API_KEY=
GLOFOX_API_TOKEN=
GLOFOX_BRANCH_ID=

# ---- Observability (Grafana log browser) ----
# REQUIRED — the grafana service refuses to start without it. Grafana is
# bound to 127.0.0.1:${GRAFANA_PORT:-3001} only (not exposed publicly);
# reach it via an SSH tunnel, see deploy/README.md's Observability section.
# Generate with: openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_run_openssl_rand_base64_18
# Optional: override the local host port Grafana binds to (default 3001),
# only needed if something else on the box already uses that port.
# GRAFANA_PORT=3001
