# Production environment for 1herosocial.ai
# Copy this file: cp deploy/.env.example deploy/.env
# Fill in real values — do NOT commit deploy/.env to git.
#
# After editing, run:  bash deploy/setup.sh

# ---- Postgres ----
POSTGRES_USER=projectx
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=projectx

# ---- Auth ----
# Long random string (32+ chars).
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_at_least_32_random_chars_xxxxxxxxxxxxxxxxxxxx

# ---- Token encryption ----
# 32-byte AES-256 key, base64-encoded. REQUIRED.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# ---- Super Admin (first login) ----
SUPER_ADMIN_EMAIL=admin@1herosocial.ai
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---- Domain & URLs ----
PUBLIC_FORM_BASE_URL=https://1herosocial.ai
FRONTEND_URL=https://1herosocial.ai

# ---- Cookies (HTTPS) ----
COOKIE_DOMAIN=1herosocial.ai
COOKIE_SECURE=true

# ---- Stripe ----
# Get this from: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ---- Google Sheets (optional) ----
# Place service-account JSON at deploy/secrets/google-credentials.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
