# Production environment configuration backup for split EC2 instance setup
# Copy to deploy/.env on the server to restore settings.

# ---- API Server ----
API_HTTP_ADDR=:8080
API_ENV=production
API_LOG_LEVEL=info

# CORS Origins matching the App Server Public IP
API_CORS_ORIGINS=http://23.21.75.112

# ---- Postgres (Decoupled on Database Server) ----
POSTGRES_HOST=172.31.47.95           # Database Server Private IP
POSTGRES_PORT=5432
POSTGRES_USER=projectx
POSTGRES_PASSWORD=projectx_dev       # Replace with your production DB password if changed
POSTGRES_DB=projectx
POSTGRES_SSLMODE=disable

# ---- Auth (Seeded Admin credentials) ----
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_TTL_HOURS=24
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMeNow!2026

# ---- Cookie Settings (Blank domain for automatic IP matching) ----
COOKIE_NAME=px_session
COOKIE_DOMAIN=
COOKIE_SECURE=false                   # Set to true only over HTTPS/SSL

# ---- Public Form URL ----
PUBLIC_FORM_BASE_URL=http://23.21.75.112

# ---- Token Encryption ----
