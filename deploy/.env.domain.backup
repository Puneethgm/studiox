# Production environment configuration backup for 1herosocial.ai domain setup
# Copy to deploy/.env on the server when domain and SSL are ready.

# ---- API Server ----
API_HTTP_ADDR=:8080
API_ENV=production
API_LOG_LEVEL=info

# CORS Origins matching the Production Domain
API_CORS_ORIGINS=https://1herosocial.ai,https://www.1herosocial.ai

# ---- Postgres (Decoupled on Database Server) ----
POSTGRES_HOST=172.31.47.95           # Database Server Private IP
POSTGRES_PORT=5432
POSTGRES_USER=projectx
POSTGRES_PASSWORD=projectx_dev       # Replace with your production DB password if changed
POSTGRES_DB=projectx
POSTGRES_SSLMODE=disable

# ---- Auth (Seeded Admin credentials) ----
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_TTL_HOURS=24
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMeNow!2026

# ---- Cookie Settings (Scoped to domain over HTTPS) ----
COOKIE_NAME=px_session
COOKIE_DOMAIN=1herosocial.ai
COOKIE_SECURE=true                    # Enable secure cookies over HTTPS

# ---- Public Form URL ----
PUBLIC_FORM_BASE_URL=https://1herosocial.ai

# ---- Token Encryption ----
TOKEN_ENCRYPTION_KEY=cBJi259qMw7qLdWUdBxH8YYOGKmdaDCiOED5knLBN4k=

# ---- Integrations ----
GOOGLE_CREDENTIALS_PATH=secrets/google-credentials.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads

# Stripe webhook signing secret (Signing secret from Stripe Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Meta App details
META_APP_ID=2405726999940224
META_APP_SECRET=d2d2fad32c909c92a83899b7ad946315
META_WEBHOOK_VERIFY_TOKEN=my_secret_token_123
META_GRAPH_API_VERSION=v25.0
