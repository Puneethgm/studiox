# Env / secrets — NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.backup
.env.bak
deploy/.env.backup
deploy/.env.*.backup
deploy/.env.domain.backup
/secrets/
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*service-account*.json

# Production deploy state — created on the EC2 box, never committed
deploy/.env
deploy/secrets/*
deploy/backups/

# Node
node_modules/
.next/
.turbo/
dist/
build/
*.tsbuildinfo
.pnpm-store/

# Go
apps/api/bin/
apps/api/tmp/
*.test
*.out
coverage.txt

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Docker volumes (if mounted locally)
.docker-data/

# WhatsApp Web session auth (mounted as Docker volume in prod)
apps/wa-web/auth/
heroic-artifact-434914-d4-1b7152cf7bec.json
# Exclude all json except package manifests
*.json
!apps/wa-web/package.json
!apps/wa-web/package-lock.json
apps/api/secrets/
!deploy/secrets/google-credentials.json
.aider*
