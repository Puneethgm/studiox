# ---- Copy to .env and fill in values ----

# --- API server ---
API_HTTP_ADDR=:8080
API_ENV=local
API_LOG_LEVEL=debug

# Comma-separated list of allowed origins for CORS. Single web app on :3000.
API_CORS_ORIGINS=http://23.21.75.112

# --- Postgres ---
POSTGRES_HOST=3.224.238.210
# 5432 is the native Postgres port on your DB server.
POSTGRES_PORT=5432
POSTGRES_USER=projectx
POSTGRES_PASSWORD=projectx_dev
POSTGRES_DB=projectx
POSTGRES_SSLMODE=disable

# --- Auth (super admin) ---
# Use a long random string. Rotated independently per environment.
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_TTL_HOURS=24

# Seeded super admin (used by `make seed-admin`). Change before first run.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMeNow!2026

# Cookie config (leave Secure=false in local; set true in prod over HTTPS)
COOKIE_NAME=px_session
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Public form ---
# Base URL where the web app serves /l/<studio-slug>/<campaign-slug>. Used to
# render shareable links in the admin UI.
PUBLIC_FORM_BASE_URL=http://23.21.75.112

# --- Google Sheets integration ---
# Path (relative to apps/api or absolute) to the service-account credentials JSON.
# See docs/SETUP_GOOGLE_SHEETS.md for the provisioning steps.
GOOGLE_CREDENTIALS_PATH=secrets/google-credentials.json

# The spreadsheet ID (from the sheet URL between /d/ and /edit).
GOOGLE_SHEETS_ID=

# The worksheet/tab name to append to (default "Leads").
GOOGLE_SHEETS_TAB=Leads

# --- Frontend (Next.js web app) ---
# Internal address of the Go API. The browser never sees this — Next.js rewrites
# `/api/*` (relative) to this URL, and server-side RSC fetches use it directly.
# Set in apps/web/.env.local — kept here for reference.
API_BASE_URL=http://localhost:8080

# --- Token encryption (channel access tokens at rest) ---
# 32-byte AES-256 key, base64-encoded. Generate with:
#   openssl rand -base64 32
# Rotating this key requires re-encrypting every channel_accounts row.
TOKEN_ENCRYPTION_KEY=replace_me_with_a_freshly_generated_32_byte_base64_key

# --- AWS S3 (image uploads for logos, social posts) ---
# Generate credentials in AWS IAM Console (s3:PutObject + s3:GetObject permissions)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET=studiox12
S3_PUBLIC_URL=https://studiox12.s3.amazonaws.com

# --- Glofox integration ---
# Credentials from the Glofox partner portal (Integrator credentials table).
# When all three are set, the studio admin is registered in Glofox on every new studio creation.
GLOFOX_API_KEY=
GLOFOX_API_TOKEN=
# Branch _id from the Glofox dashboard (Settings > Locations)
GLOFOX_BRANCH_ID=
# Studio is auto-detected at startup from whichever studio has an active WhatsApp channel.

# --- Meta App (single platform-wide app; each studio brings its own WABA) ---
# Find at https://developers.facebook.com/apps/<your-app>/settings/basic/
META_APP_ID=2405726999940224
META_APP_SECRET=d2d2fad32c909c92a83899b7ad946315
# Arbitrary string you set on Meta's webhook config + here. Used during the
# GET handshake when Meta first verifies the webhook URL.
META_WEBHOOK_VERIFY_TOKEN=my_secret_token_123
# Meta deprecated v21 in May 2026 — using v25.
META_GRAPH_API_VERSION=v25.0
